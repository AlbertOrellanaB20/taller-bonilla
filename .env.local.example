NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave de servicio (service role) — SOLO se usa en el servidor (Server Actions),
# nunca se expone al navegador. Se usa para buscar el correo de un usuario a
# partir de su nombre de usuario antes de autenticar con Supabase Auth.
# La encuentras en Supabase > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=
